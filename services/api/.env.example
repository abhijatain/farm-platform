
DATABASE_URL=postgresql+psycopg://farmapp:password@localhost:5432/farmdb

ENVIRONMENT=development

FIREBASE_PROJECT_ID=your-auth-firebase-project-id

# Optional if GOOGLE_APPLICATION_CREDENTIALS is already exported.
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/firebase-service-account.json

# Private GCS bucket. The service account may belong to another project
# provided it has the required bucket IAM permissions.
GCS_BUCKET_NAME=jatain-farm
GCS_PROJECT_ID=your-storage-project-id
GCS_CREDENTIALS_PATH=/absolute/path/to/firebase-service-account.json

MEDIA_UPLOAD_URL_EXPIRY_MINUTES=15
MEDIA_DOWNLOAD_URL_EXPIRY_MINUTES=30

MEDIA_MAX_IMAGE_BYTES=26214400
MEDIA_MAX_VIDEO_BYTES=524288000

MEDIA_DERIVATIVES_ENABLED=true
MEDIA_THUMBNAIL_MAX_PIXELS=1200
MEDIA_THUMBNAIL_WEBP_QUALITY=82
MEDIA_VIDEO_POSTER_MAX_PIXELS=1280

FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Automatic satellite ingestion
SATELLITE_INITIAL_BACKFILL_DAYS=90

# Open-Meteo commercial key: required in production; optional for local non-commercial development.
# Never expose this as a VITE_ frontend variable.
WEATHER_API_KEY=

# WhatsApp is opt-in. Set false for the first public release.
# Disables webhook/link HTTP routes even if Meta credentials exist.
WHATSAPP_ENABLED=false

# Meta settings remain server-side. Not required while disabled.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Required only for farmer account linking; find under WhatsApp API Setup.
WHATSAPP_PHONE_NUMBER_ID=

# Same random secret configured in the PRIVATE tiler service, never browser.
SATELLITE_TILER_SHARED_TOKEN=REPLACE_WITH_RANDOM_PRIVATE_SECRET
