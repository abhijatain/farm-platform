
DATABASE_URL=postgresql+psycopg://farmapp:password@localhost:5432/farmdb

ENVIRONMENT=development

FIREBASE_PROJECT_ID=your-firebase-project-id

GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json

STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/storage

MEDIA_UPLOAD_URL_EXPIRY_MINUTES=15
MEDIA_DOWNLOAD_URL_EXPIRY_MINUTES=30

MEDIA_MAX_IMAGE_BYTES=26214400
MEDIA_MAX_VIDEO_BYTES=524288000

MEDIA_DERIVATIVES_ENABLED=true
MEDIA_THUMBNAIL_MAX_PIXELS=1200
MEDIA_THUMBNAIL_WEBP_QUALITY=82
MEDIA_VIDEO_POSTER_MAX_PIXELS=1280

FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# GCS later:
# STORAGE_BACKEND=gcs
# GCS_BUCKET_NAME=your-private-bucket
# GCS_PROJECT_ID=your-google-cloud-project
# GCS_CREDENTIALS_PATH=/absolute/path/to/storage-service-account.json
