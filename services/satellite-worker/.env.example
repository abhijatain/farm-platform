
DATABASE_URL=postgresql+psycopg://farmapp:password@localhost:5432/farmdb

EARTH_SEARCH_URL=https://earth-search.aws.element84.com/v1

# Local directory used to generate/stage COGs before cloud publication.
SATELLITE_OUTPUT_DIR=./data/satellite

# local | gcs
SATELLITE_STORAGE_BACKEND=gcs

GCS_BUCKET_NAME=jatain-farm

# Project that owns the GCS bucket.
GCS_PROJECT_ID=your-storage-project-id

# May point to the same cross-project service-account JSON used by the API,
# provided that exact principal has Storage Object Admin on this bucket.
GCS_CREDENTIALS_PATH=/home/your-user/.config/farm-platform/firebase-service-account.json

SATELLITE_DELETE_LOCAL_AFTER_UPLOAD=true
