
DATABASE_URL=postgresql+psycopg://farmapp:password@localhost:5432/farmdb

EARTH_SEARCH_URL=https://earth-search.aws.element84.com/v1

GCS_BUCKET_NAME=jatain-farm
GCS_PROJECT_ID=your-storage-project-id
GCS_CREDENTIALS_PATH=/absolute/path/to/firebase-service-account.json

# Automatic satellite ingestion worker
SATELLITE_JOB_POLL_SECONDS=15
SATELLITE_INCREMENTAL_ENQUEUE_INTERVAL_MINUTES=60
SATELLITE_INCREMENTAL_LOOKBACK_DAYS=14
SATELLITE_INITIAL_BACKFILL_DAYS=90
SATELLITE_JOB_RETRY_DELAY_MINUTES=15
SATELLITE_JOB_STALE_AFTER_MINUTES=720
SATELLITE_JOB_MAX_ATTEMPTS=3
SATELLITE_MAX_SCENE_CLOUD=60
SATELLITE_SCENE_LIMIT=20

# Additional radar/thermal STAC source
PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
