
# Project that owns the bucket.
GCS_PROJECT_ID=your-storage-project-id

GCS_BUCKET_NAME=jatain-farm

# Same service-account JSON can be used locally if that principal has
# Storage Object Viewer/Admin on the bucket.
GCS_CREDENTIALS_PATH=/home/your-user/.config/farm-platform/firebase-service-account.json

GCS_READ_URL_EXPIRY_MINUTES=15

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
