VITE_API_URL=/api/v1

VITE_MAPTILER_KEY=YOUR_MAPTILER_KEY
# Direct local development only; HTTPS ngrok requires a secured tile gateway.
VITE_TILER_URL=http://localhost:8081
# Optional development-only tiler proxy; never enable with private farm data
# or a publicly shared URL until per-user tiler authorization is implemented.
ENABLE_DEV_TILER_PROXY=false


VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID


# ONLY while using Firebase fictional test phone numbers.
VITE_FIREBASE_TEST_PHONE_AUTH=false
