VITE_API_URL=/api/v1

# First public release: hide WhatsApp linking/navigation (requires Vite rebuild).
VITE_ENABLE_WHATSAPP=false

VITE_MAPTILER_KEY=YOUR_MAPTILER_KEY
# Satellite tiles are fetched through the authenticated API. No public tiler URL.\n\nVITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID


# ONLY while using Firebase fictional test phone numbers.
VITE_FIREBASE_TEST_PHONE_AUTH=false
